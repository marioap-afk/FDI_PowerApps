flowchart TB
 subgraph subGraph0["Captura por diseño"]
    CAR["Sección: Carga / producto"]
    CONF["Sección: Configuración del rack (cantiléver)"]
    AREA["Sección: Área disponible / pasillos"]
    N["Sección: Criterios para configuración de niveles"]
    SEG["Sección: Elementos de seguridad"]
    PE["Sección: Piezas especiales"]

    CAR1["Tipo de producto (texto abierto)"]
    CAR2["Longitud de la carga"]
    CAR3["Sección / diámetro / ancho"]
    CAR4["Peso por pieza / por nivel"]
    CAR5["Cantidad por nivel"]

    CONF1{"¿Tipo de góndola?"}
    CONF1A["Góndola sencilla"]
    CONF1B["Góndola doble"]
    CONF1C["Ambas"]
    CONF1D["Por diseño"]

    P1["Pasillo máximo de montacargas"]
