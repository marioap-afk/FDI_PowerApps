    F{"¿Requiere instalación?"}
    G{"¿Requiere memoria de cálculo?"}
    U{"¿Unirse a estructura del cliente?"}
    H{"¿Se consideran proveedores externos?"}
    I["Comentarios generales del sistema"]
    D1["Pintado"]
    D2["Galvanizado en frío"]
    D3["Galvanizado en caliente"]
    D4["Pregalvanizado"]
    P["Precio por kilogramo"]
    F1["Costo de instalación"]
    F2["Comentarios de instalación"]
    G1["Costo de memoria de cálculo"]
    U1["Comentarios / requisitos"]
    H1["Tabla: Proveedores externos"]
 end

 A["Sistema cantiléver"] --> B{"Método de captura"} & D & E & F & G & U & H & I

 %% Método de captura
 B -- Diseño --> subGraph0
 B -- Listado de piezas --> LP["Tabla: Listado de piezas"]
 B -- Planos/diseño de cliente --> CLI["Adjuntar planos/diseño de cliente"]
 B -- Cotización o pedido anterior --> subGraph1

 %% Con planos del cliente igual se verifica la carga (corroborar perfiles fabricados)
 CLI -- Verificar perfiles --> CAR

 %% Carga / producto
 CAR --> CAR1 & CAR2 & CAR3 & CAR4 & CAR5

 %% Configuración del rack (cantiléver)
 %% Nota: número de columnas, longitud/capacidad de brazo, altura de columna,
 %% separación, base, voladizo e inclinación los deriva ingeniería del producto;
 %% no se capturan aquí.
 CONF --> CONF1
 CONF1 --> CONF1A & CONF1B & CONF1C & CONF1D

 %% Área disponible / pasillos
 AREA --> P1 & P2 & P3 & P4

 %% Criterios para configuración de niveles (determinan los niveles de brazos)
 N --> N1 & N2 & N3 & N4
 N1 -- Sí --> N1A
 N2 -- Sí --> N2A & N2B
 N3 -- Sí --> N3B
 N4 -- Sí --> N4A

 %% Elementos de seguridad
 SEG --> SEG1
 SEG1 -- Sí --> SEG2

 %% Piezas especiales
 PE --> PE1
 PE1 -- Sí --> PE2

 %% Datos comunes del sistema
 D --> D1 & D2 & D3 & D4
 D2 --> P
 D3 --> P
 F -- Sí --> F1 & F2
 G -- Sí --> G1
 U -- Sí --> U1
 H -- Sí --> H1
