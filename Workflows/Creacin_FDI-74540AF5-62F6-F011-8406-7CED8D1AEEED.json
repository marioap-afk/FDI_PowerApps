            "Apply_to_each_SEL": {
              "type": "Foreach",
              "foreach": "@body('Get_sistemas_sel')?['value']",
              "actions": {
                "Parse_SEL_PayloadSistemaJson": {
                  "type": "Compose",
                  "inputs": "@if(empty(trim(string(items('Apply_to_each_SEL')?['PayloadSistemaJson']))), json('{}'), json(items('Apply_to_each_SEL')?['PayloadSistemaJson']))"
                },
                "SEL_payload": {
                  "type": "Compose",
                  "inputs": "@setProperty(setProperty(setProperty(setProperty(setProperty(setProperty(outputs('Parse_SEL_PayloadSistemaJson'), 'Tipo', 'SEL'), 'TipoKey', 'SEL'), 'RegistroID', items('Apply_to_each_SEL')?['ID']), 'SistemaId', coalesce(outputs('Parse_SEL_PayloadSistemaJson')?['SistemaId'], items('Apply_to_each_SEL')?['SistemaID']?['Id'], items('Apply_to_each_SEL')?['SistemaID/Id'], items('Apply_to_each_SEL')?['ID'])), 'NombreSistema', coalesce(outputs('Parse_SEL_PayloadSistemaJson')?['NombreSistema'], items('Apply_to_each_SEL')?['Title'])), 'Folio', items('Apply_to_each_SEL')?['Folio'])",
                  "runAfter": {
                    "Parse_SEL_PayloadSistemaJson": [
                      "Succeeded"
                    ]
                  }
                },
                "Append_SEL_to_varSistemas": {
                  "type": "AppendToArrayVariable",
                  "inputs": {
                    "name": "varSistemas",
                    "value": "@outputs('SEL_payload')"
                  },
                  "runAfter": {
                    "SEL_payload": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "runAfter": {
                "Payload_Cotizacion": [
                  "Succeeded"
                ]
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              }
            },
            "Apply_to_each_OT": {
              "type": "Foreach",
              "foreach": "@body('Get_sistemas_ot')?['value']",
              "actions": {
                "Append_OT_to_varSistemas": {
                  "type": "AppendToArrayVariable",
                  "inputs": {
                    "name": "varSistemas",
                    "value": {
                      "Tipo": "OT",
                      "TipoKey": "OT",
                      "RegistroID": "@items('Apply_to_each_OT')?['ID']",
                      "SistemaId": "@coalesce(items('Apply_to_each_OT')?['SistemaID']?['Id'], items('Apply_to_each_OT')?['SistemaID/Id'], items('Apply_to_each_OT')?['ID'])",
                      "NombreSistema": "@items('Apply_to_each_OT')?['Title']",
