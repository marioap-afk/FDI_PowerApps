                    "AltCritMonta": "@items('Apply_to_each_SEL')?['Alturacr_x00ed_ticademontacargas']",
                    "AltCritNiv": "@items('Apply_to_each_SEL')?['Alturacr_x00ed_ticadeniveles']",
                    "DefPorCliente": "@items('Apply_to_each_SEL')?['Definidoporelcliente']",
                    "NumPedidoCot": "@items('Apply_to_each_SEL')?['N_x00fa_merodepedidoocotizaci_x0']",
                    "Galvanizado": "@items('Apply_to_each_SEL')?['Galvanizado']",
                    "TipoGalv": "@items('Apply_to_each_SEL')?['Tipodegalvanizado']?['Value']",
                    "PpkgGalv": "@items('Apply_to_each_SEL')?['Precioporkilogramogalvanizado']",
                    "Instalacion": "@items('Apply_to_each_SEL')?['Instalaci_x00f3_n']",
                    "MemCalc": "@items('Apply_to_each_SEL')?['Memoriadec_x00e1_lculo']",
                    "EstProv": "@items('Apply_to_each_SEL')?['Unirseaestructuradeotroproveedor']",
                    "ProvExternos": "@items('Apply_to_each_SEL')?['Proveedoresexternos']",
                    "ConsEsp": "@items('Apply_to_each_SEL')?['Consideracionesespeciales']",
                    "PiezasResumen": "@items('Apply_to_each_SEL')?['Piezasdeusuario']",
                    "ElementosSeguridadResumen": "@items('Apply_to_each_SEL')?['Elementosdeseguridad']"
                  }
                },
                "Append_SEL_to_varSistemas": {
                  "type": "AppendToArrayVariable",
                  "inputs": {
                    "name": "varSistemas",
                    "value": "@outputs('SEL_payload')"
                  },
                  "runAfter": {
                    "SEL_payload": [
                      "Succeeded"
                    ]
