                }
              },
              "runAfter": {
                "Payload_Cotizacion": [
                  "Succeeded"
                ]
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              }
            },
            "Apply_to_each_OT": {
              "type": "Foreach",
              "foreach": "@body('Get_sistemas_ot')?['value']",
