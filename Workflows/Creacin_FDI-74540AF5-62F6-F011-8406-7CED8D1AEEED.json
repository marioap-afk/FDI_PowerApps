                ]
              }
            },
            "Apply_to_each_SEL": {
              "type": "Foreach",
              "foreach": "@body('Get_sistemas_sel')?['value']",
              "actions": {
                "SEL_payload": {
                  "type": "Compose",
                  "inputs": {
                    "Tipo": "SEL",
                    "TipoKey": "SEL",
                    "RegistroID": "@items('Apply_to_each_SEL')?['ID']",
                    "SistemaId": "@coalesce(items('Apply_to_each_SEL')?['SistemaID']?['Id'], items('Apply_to_each_SEL')?['SistemaID/Id'], items('Apply_to_each_SEL')?['ID'])",
