                "Fianzas": "@outputs('CotizacionActual')?['Fianzas']",
                "Póliza de responsabilidad civil": "@outputs('CotizacionActual')?['P_x00f3_lizaderesponsabilidadciv']",
                "Monto de póliza": "@outputs('CotizacionActual')?['Montodep_x00f3_liza']",
                "Licitación": "@outputs('CotizacionActual')?['Licitaci_x00f3_n']",
                "Fecha de entrega": "@outputs('CotizacionActual')?['Fechadeentrega']",
                "Prioridad": "@outputs('CotizacionActual')?['Prioridad']?['Value']",
                "Estado": "@outputs('CotizacionActual')?['Estado']?['Value']",
                "Created By": "@outputs('CotizacionActual')?['Author']?['DisplayName']",
